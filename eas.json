{
  "cli": {
    "version": "20.1.0",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "node": "22.21.1",
      "env": {
        "NPM_CONFIG_PRODUCTION": "false"
      }
    },
    "development": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development"
    },
    "preview": {
      "extends": "base",
      "distribution": "internal",
      "environment": "preview"
    },
    "beta": {
      "extends": "base",
      "distribution": "store",
      "autoIncrement": true,
      "environment": "preview",
      "android": {
        "buildType": "app-bundle"
      }
    },
    "production": {
      "extends": "base",
      "autoIncrement": true,
      "environment": "production",
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "beta": {
      "android": {
        "serviceAccountKeyPath": "./google-service-account.json",
        "track": "internal",
        "releaseStatus": "completed"
      }
    },
    "open": {
      "android": {
        "serviceAccountKeyPath": "./google-service-account.json",
        "track": "beta",
        "releaseStatus": "completed"
      }
    },
    "production": {
      "android": {
        "serviceAccountKeyPath": "./google-service-account.json",
        "track": "production",
        "releaseStatus": "completed"
      }
    }
  }
}
