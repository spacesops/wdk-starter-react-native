# WDK Indexer
EXPO_PUBLIC_WDK_INDEXER_BASE_URL=https://wdk-api.tether.io
EXPO_PUBLIC_WDK_INDEXER_API_KEY=PUT_WDK_API_KEY_HERE

# Tron network (optional)
EXPO_PUBLIC_TRON_API_KEY=PUT_HERE
EXPO_PUBLIC_TRON_API_SECRET=PUT_HERE

# Bitcoin / Electrum
EXPO_PUBLIC_BITCOIN_NETWORK=bitcoin
EXPO_PUBLIC_ELECTRS_HOST=
EXPO_PUBLIC_ELECTRS_PORT=
EXPO_PUBLIC_ELECTRS_PROTOCOL=tcp
EXPO_PUBLIC_BITCOIN_P2TR_MEMO=

# Spaces protocol
EXPO_PUBLIC_SPACES_API_BASE_URL=http://192.168.1.111:7264

# Find Spaces: BIP path scan (m/{bip}'/{coin}'/{account}'/0/index…)
EXPO_PUBLIC_SPACES_ACCOUNT_NUMBER=0
EXPO_PUBLIC_SPACES_ACCOUNT_GAP=3

# Pricing slugs (Spaces API)
EXPO_PUBLIC_PRICE_SLUG_BTC=bitcoin
EXPO_PUBLIC_PRICE_SLUG_XAUT=tether-gold

# Dev / debug toggles
EXPO_PUBLIC_CLEAR_PRICES=false
EXPO_PUBLIC_MOCK_XAUT_TRANSFERS=false

# Local-only (not required for EAS builds)
# ETHEREUM_ACCT=
# IOS_DEVELOPMENT_TEAM=
