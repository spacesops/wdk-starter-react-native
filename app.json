{
  "expo": {
    "name": "SpacesWallet",
    "slug": "spaces-wallet",
    "owner": "koine",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "wdkstarterreactnative",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lcfx.spaceswallet",
      "buildNumber": "13",
      "infoPlist": {
        "UIStatusBarStyle": "UIStatusBarStyleLightContent",
        "UIViewControllerBasedStatusBarAppearance": false,
        "NSFaceIDUsageDescription": "This app uses Face ID to secure your wallet and authenticate transactions.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "appleTeamId": "YDF9P54VLB"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.lcfx.spaceswallet",
      "versionCode": 13,
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "splash": {
      "image": "./assets/images/splash-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#AA4981",
      "dark": {
        "backgroundColor": "#AA4981"
      }
    },
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      "expo-dev-client",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#AA4981"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "SpacesWallet uses the camera only to scan QR codes. For example, scan a recipient's Bitcoin or USD₮ address QR code to fill in the send form automatically, or scan a QR code of your 12-word recovery phrase to restore an existing wallet. No photos or video are ever recorded, stored, or shared.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 29,
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "buildToolsVersion": "36.0.0",
            "useLegacyPackaging": false,
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "enableMinifyInReleaseBuilds": true
          }
        }
      ],
      "./plugins/withAndroidSubprojects.js",
      "./plugins/withDisableSwiftUICoreAutolink.js",
      "./plugins/withLibveritasIosLinkerFix.js"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5df02f86-b279-4bbd-a63c-d5b2bd79d853"
      }
    }
  }
}
