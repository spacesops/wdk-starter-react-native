{
  "name": "@tetherto/wdk-starter-react-native",
  "main": "expo-router/entry",
  "version": "1.0.2",
  "scripts": {
    "start": "expo start --dev-client",
    "start:android": "expo start --dev-client --localhost",
    "start:clear": "expo start --dev-client --clear",
    "start:clear:android": "expo start --dev-client --clear --localhost",
    "android": "node scripts/patch-bare-link-android.js && node scripts/patch-expo-android-bin-dirs.js && node scripts/patch-android-settings-node.js && node scripts/setup-android-metro-forward.js && REACT_NATIVE_PACKAGER_HOSTNAME=localhost expo run:android",
    "android:prod": "node scripts/patch-bare-link-android.js && node scripts/patch-android-settings-node.js && expo run:android --variant release",
    "android:build:release": "node scripts/patch-bare-link-android.js && node scripts/patch-android-settings-node.js && cd android && ./gradlew assembleRelease && cd .. && APK_PATH=\"android/app/build/outputs/apk/release/app-release.apk\" && if [ -f \"$APK_PATH\" ]; then echo \"\" && echo \"✓ Android production APK built successfully!\" && echo \"📦 APK Location: $(pwd)/$APK_PATH\" && echo \"📊 File size: $(du -h \"$APK_PATH\" | cut -f1)\" && echo \"\"; else echo \"❌ Error: APK not found at $APK_PATH\"; exit 1; fi",
    "android:beta:build": "eas build --platform android --profile beta",
    "android:beta:submit": "eas submit --platform android --profile beta --latest",
    "android:beta:verify": "./scripts/verify-play-eas-integration.sh",
    "android:beta": "eas build --platform android --profile beta --auto-submit",
    "android:open:build": "eas build --platform android --profile beta",
    "android:open:submit": "eas submit --platform android --profile open --latest",
    "android:open": "eas build --platform android --profile beta --auto-submit-with-profile open",
    "android:preview": "eas build --platform android --profile preview",
    "beta": "eas build --platform all --profile beta --auto-submit",
    "ios": "node scripts/ensure-ios-rncore-debug.js && expo run:ios",
    "ios:prod": "node scripts/patch-react-native-libveritas.js && expo run:ios --configuration Release",
    "ios:prod:device": "node scripts/patch-react-native-libveritas.js && expo run:ios --configuration Release --device",
    "ios:debug:iphone8": "expo run:ios --device iPhone8",
    "ios:release:iphone8": "expo run:ios --configuration Release --device iPhone8",
    "ios:beta:build": "eas build --platform ios --profile beta",
    "ios:beta:submit": "eas submit --platform ios --profile beta --latest",
    "ios:beta": "eas build --platform ios --profile beta --auto-submit",
    "ios:testflight:prepare": "npm run prebuild && ./scripts/patch-ios-dev-team.sh && echo \"✓ iOS project prepared for TestFlight. Opening Xcode...\" && open ios/$(node -p \"require('./app.json').expo.name\").xcworkspace",
    "web": "expo start --web",
    "lint": "expo lint",
    "lint:fix": "expo lint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "gen:bundle": "npm --prefix node_modules/@spacesops/pear-wrk-wdk run gen:mobile-bundle",
    "rebuild-wdk-bundle": "./scripts/rebuild-wdk-bundle.sh",
    "postinstall": "node scripts/ensure-bare-performance-prebuilds.js && node scripts/patch-pear-wrk-taproot-keys.js && node scripts/patch-wdk-wallet-btc-memo-coinselect.js && node scripts/patch-react-native-libveritas.js && node scripts/patch-bare-link-android.js && node scripts/patch-expo-android-bin-dirs.js && node scripts/patch-android-16kb-page-size.js",
    "eas-build-post-install": "node scripts/ensure-bare-performance-prebuilds.js && node scripts/patch-pear-wrk-taproot-keys.js && node scripts/patch-wdk-wallet-btc-memo-coinselect.js && node scripts/patch-react-native-libveritas.js && node scripts/patch-bare-link-android.js && node scripts/patch-expo-android-bin-dirs.js && node scripts/patch-android-16kb-page-size.js && node scripts/ensure-ios-rncore-debug.js",
    "prebuild": "expo prebuild",
    "prebuild:clean": "expo prebuild --clean",
    "env:push:eas": "./scripts/push-env-to-eas.sh",
    "test:electrs": "./scripts/test-electrs.sh"
  },
  "dependencies": {
    "@bitcoinerlab/secp256k1": "^1.2.0",
    "@craftzdog/react-native-buffer": "^6.1.0",
    "@expo/vector-icons": "^15.0.2",
    "@gorhom/bottom-sheet": "^5.2.6",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "@reduxjs/toolkit": "^2.9.0",
    "@spacesops/react-native-bare-kit": "0.11.0-beta.49",
    "@spacesops/wdk-react-native-core": "^1.0.0-beta.76",
    "@spacesprotocol/react-native-libveritas": "^0.4.2",
    "@tetherto/wdk-pricing-bitfinex-http": "^1.0.0-beta.1",
    "@tetherto/wdk-pricing-provider": "^1.0.0-beta.1",
    "@tetherto/wdk-uikit-react-native": "^1.0.0-beta.2",
    "@ton/core": "^0.62.0",
    "bip39": "^3.1.0",
    "browserify-zlib": "^0.2.0",
    "decimal.js": "^10.6.0",
    "events": "^3.3.0",
    "expo": "~54.0.37",
    "expo-build-properties": "~1.0.9",
    "expo-camera": "~17.0.8",
    "expo-clipboard": "~8.0.7",
    "expo-constants": "~18.0.14",
    "expo-crypto": "^15.0.7",
    "expo-dev-client": "^6.0.12",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.24",
    "expo-font": "~14.0.8",
    "expo-haptics": "~15.0.7",
    "expo-image": "~3.0.8",
    "expo-linking": "~8.0.8",
    "expo-local-authentication": "~17.0.9",
    "expo-router": "~6.0.6",
    "expo-sharing": "~14.0.8",
    "expo-splash-screen": "~31.0.10",
    "expo-status-bar": "~3.0.8",
    "expo-symbols": "~1.0.7",
    "expo-system-ui": "~6.0.7",
    "expo-web-browser": "~15.0.7",
    "http2-wrapper": "^2.2.1",
    "https-browserify": "^1.0.0",
    "lucide-react-native": "^0.544.0",
    "nice-grpc-web": "^3.3.8",
    "path-browserify": "^1.0.1",
    "process": "^0.11.10",
    "querystring-es3": "^0.2.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-chart-kit": "^6.12.0",
    "react-native-crypto": "^2.2.1",
    "react-native-device-info": "^14.1.1",
    "react-native-fast-pbkdf2": "^0.3.1",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-get-random-values": "^1.11.0",
    "react-native-keychain": "^10.0.0",
    "react-native-nitro-modules": "^0.35.0",
    "react-native-qr-svg": "^1.5.0",
    "react-native-randombytes": "^3.6.2",
    "react-native-reanimated": "~4.1.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-tcp-socket": "^6.3.0",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1",
    "react-redux": "^9.2.0",
    "sodium-javascript": "^0.8.0",
    "sonner-native": "^0.21.1",
    "stream-browserify": "^3.0.0",
    "stream-http": "^3.2.0",
    "uniffi-bindgen-react-native": "^0.29.3-1"
  },
  "devDependencies": {
    "@types/b4a": "^1.6.5",
    "@types/react": "~19.1.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "prettier": "^3.6.2",
    "react-native-svg-transformer": "^1.5.1",
    "sharp-cli": "^5.2.0",
    "typescript": "~5.9.2"
  },
  "engines": {
    "node": "22.21.1"
  },
  "peerDependencies": {
    "react": "19.1.0",
    "react-native": "0.81.5"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-tcp-socket",
          "react-native-randombytes",
          "@spacesprotocol/react-native-libveritas",
          "react-native-fast-pbkdf2"
        ],
        "listUnknownPackages": false
      }
    }
  },
  "overrides": {
    "expo-crypto": "$expo-crypto",
    "expo-local-authentication": "$expo-local-authentication",
    "@spacesops/wdk-react-native-core": {
      "@tetherto/wdk-react-native-secure-storage": {
        "expo-crypto": "$expo-crypto",
        "expo-local-authentication": "$expo-local-authentication"
      }
    },
    "@tetherto/wdk-react-native-secure-storage": {
      "expo-crypto": "$expo-crypto",
      "expo-local-authentication": "$expo-local-authentication"
    }
  }
}
